# ──────────────────────────────
# SGFIP — Configuración de entorno
# ──────────────────────────────
# Copie este archivo como .env y ajuste los valores

APP_NAME=SGFIP Backend

# Cambiar a "production" cuando esté en producción
NODE_ENV=development

# Puerto del servidor
PORT=3000

# URL del frontend (para CORS en producción)
FRONTEND_URL=http://localhost:3000

# ─── Base de datos ─────────────────────────────
# Para desarrollo local:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sgfip

# Para producción (Neon):
# DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_USER=fl0w3r_owner
# DB_PASSWORD=xxxxx
# DB_NAME=fl0w3r
# Nota: Neon usa un solo database por proyecto, el nombre se obtiene del connection string

# ─── Autenticación ─────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string
JWT_EXPIRES_IN_SECONDS=86400

# 1=Admin, 2=Inspector, 3=Supervisor
AUTH_DEFAULT_ROLE_ID=2
